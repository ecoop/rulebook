# Environment / secrets
.env
.env.local
.env.*.local

# Local invite-token workspace (names, minted tokens, invite links)
secrets/

# Internal notes — private working docs (e.g. legal/copyright self-assessments)
# that must never ship in a public repo.
notes/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Jupyter
.ipynb_checkpoints/

# Local vector index — regenerated by scripts/build_index.py
data/index/

# Q&A and feedback logs — user-generated data, not for commit
data/logs/

# llm-guardrails cost counter state — per-instance mutable state
data/cost_counter.json

# Node / Vite
node_modules/
web/dist/
web/.vite/

# macOS
.DS_Store

# IDE
.vscode/
.idea/

# Claude Code local session/editor state (launch.json, settings.local.json, …)
.claude/

# Copyrighted rule sources — never commit (see rules/SOURCES.md). The running
# service syncs them from GCS at runtime (rules_sync); local copies stay local.
rules/**/*.pdf
rules/**/*.extracted.md

# Ruleset markers (.ruleset.json, machine-written by the build; see
# docs/design/ruleset-editions.md). A marker belongs with its ruleset's files:
# your own rulesets' markers stay local (and reach GCS via publish_rules), while
# the committed samples' markers are tracked so a fresh clone builds clean.
rules/**/.ruleset.json
!rules/checkers/.ruleset.json
!rules/poker/.ruleset.json
!rules/tennis/.ruleset.json
