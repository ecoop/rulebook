{#-
  The results page's look: nbconvert's standard "lab" page plus a few layout
  rules, so it reads like an article rather than a full-width notebook dump.
  Used by .github/workflows/notebook-page.yml (`--template page_template`).
-#}
{%- extends 'lab/index.html.j2' -%}

{%- block html_head_css -%}
{{ super() }}
<style>
  /* One readable column, centred, with room at the edges. */
  body {
    max-width: 920px;
    margin: 0 auto;
    padding: 32px 20px 96px;
  }
  /* Space between cells, and a little more before each heading. */
  .jp-Cell + .jp-Cell { margin-top: 18px; }
  .jp-MarkdownCell:has(h2) { margin-top: 40px; }
  /* Body text: comfortable line height. */
  .jp-RenderedMarkdown { font-size: 15px; line-height: 1.6; }
  .jp-RenderedMarkdown p, .jp-RenderedMarkdown li { margin-bottom: 0.6em; }
  /* Code: set off from the text, with breathing room around outputs. */
  .jp-InputArea-editor { border-radius: 6px; padding: 4px 6px; }
  .jp-OutputArea { margin-top: 8px; }
  .jp-OutputArea-output pre { line-height: 1.45; }
  /* Output tables line up with output text and get some air. */
  .jp-OutputArea-output table { margin: 6px 0 4px 0; }
  /* Top bar: back to the notebooks page, and this notebook in Colab. */
  .page-bar {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 16px;
    font: 14px/1.5 system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
    padding-bottom: 10px; margin-bottom: 18px; border-bottom: 1px solid #e0e0e0;
  }
  .page-bar a { color: #1976d2; text-decoration: none; }
  .page-bar a:hover { text-decoration: underline; }
  .page-bar .colab { font-weight: 600; }
  /* The notebook's vignette (img/, drawn by vignettes.py), beside the title. */
  .vignette { float: right; width: 220px; height: auto; margin: 4px 0 12px 28px; }
  @media (max-width: 560px) {
    .vignette { float: none; display: block; width: 100%; max-width: 260px; margin: 0 0 8px; }
  }
</style>
{%- endblock html_head_css -%}

{#- Cells only for someone running the notebook are left off the page: run-only
    (how to run it) and run-setup (the setup code; it still runs, since later cells
    need it, but its code and output aren't shown). Skipped here, after execution. -#}
{%- block any_cell -%}
{%- set tags = cell.metadata.get('tags', []) -%}
{%- if 'run-only' not in tags and 'run-setup' not in tags -%}
{{ super() }}
{%- endif -%}
{%- endblock any_cell -%}

{#- The page's own chrome (not in the notebook, so Colab doesn't show it): a bar
    back to the notebooks page and to this notebook in Colab, then the vignette.
    Vignette names match VIGNETTES in vignettes.py; a notebook without one gets no image. -#}
{%- block body_header -%}
{{ super() }}
{%- set name = resources['metadata']['name'] %}
<nav class="page-bar">
  <a href="./">&larr; Learn RAG with Rulebook: all notebooks</a>
  <a class="colab" href="https://colab.research.google.com/github/ecoop/rulebook/blob/main/notebooks/{{ name }}.ipynb">Run it in Colab</a>
</nav>
{%- if name in ['rag_at_a_glance', 'embeddings', 'evaluation', 'reranking', 'chunking'] %}
<img class="vignette" src="img/{{ name }}.svg" alt="">
{%- endif %}
{%- endblock body_header -%}
