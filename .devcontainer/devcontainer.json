{
  // GitHub Codespaces / VS Code Dev Containers: the whole repo, ready to run.
  // First launch installs everything (a couple of minutes); no API key needed for
  // the notebooks' retrieval and eval, which use small local models.
  "name": "rulebook",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "python -m pip install --user --quiet uv && python -m uv sync && python -m uv run nbstripout --install",
  "customizations": {
    "codespaces": {
      "openFiles": ["notebooks/embeddings_and_eval.ipynb"]
    },
    "vscode": {
      "extensions": ["ms-python.python", "ms-toolsai.jupyter"],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python"
      }
    }
  }
}
