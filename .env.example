# Copy this file to `.env`. Every key here is OPTIONAL — copied as-is, the
# key-free path (local embeddings, build_index, retrieve, eval, the notebook)
# runs with no keys at all. Add only what the feature you want needs. Never
# commit .env.
# ---------------------------------------------------------------------------

# Claude (generation) — needed ONLY to generate answers (`ask` CLI / the web app).
# Uncomment and set it for that; everything else works without it. Get one at
# https://console.anthropic.com/ (billed per-token, pennies for this project;
# Claude Max does NOT cover programmatic API usage).
# ANTHROPIC_API_KEY=sk-ant-...

# Voyage AI (optional — only if you set EMBEDDING_PROVIDER=voyage below).
# Anthropic's recommended partner for embeddings. Cost: ~$0.06 / 1M tokens.
# https://www.voyageai.com/
# VOYAGE_API_KEY=pa-...

# OpenAI (optional — only needed if you set EMBEDDING_PROVIDER=openai below)
# OPENAI_API_KEY=sk-...

# ---------------------------------------------------------------------------
# Provider + model selection. Change these to swap models without editing code.
# ---------------------------------------------------------------------------

# Which embedding backend to use. Options: local | voyage | openai
#
# "local" is the DEFAULT: a model2vec static model on your CPU — no key, no cost,
# no torch (so it installs anywhere). The first run downloads the model (tens of
# MB) and caches it. Only generation (ANTHROPIC_API_KEY) needs a key. Switch to
# voyage/openai for stronger embeddings on larger/messier corpora.
EMBEDDING_PROVIDER=local

# Model name for the chosen provider. NOTE: changing this requires REBUILDING the
# index (scripts/build_index.py) — query and stored vectors must come from the
# same model (and match dimensions). It is not a live, per-request switch.
# Set this TOGETHER with the provider above.
#   local:  minishlab/potion-retrieval-32M (default), or any model2vec id
#   voyage: voyage-4, voyage-4-lite, voyage-4-large
#   openai: text-embedding-3-small, text-embedding-3-large
EMBEDDING_MODEL=minishlab/potion-retrieval-32M

# Claude model used for answer generation.
#   claude-haiku-4-5           — fastest, cheapest, good enough for this task
#   claude-sonnet-5            — better reasoning, slightly slower
CLAUDE_MODEL=claude-sonnet-5

# Effort for answer generation: low | medium | high | xhigh | max. Thinking
# tokens are billed as output, so lower effort is cheaper. Leave empty to omit
# the parameter (models without effort support, e.g. claude-haiku-4-5).
CLAUDE_EFFORT=low

# Where the local vector index lives on disk (relative to repo root).
# The directory holds vectors.npy + chunks.jsonl + manifest.json.
INDEX_PATH=./data/index
