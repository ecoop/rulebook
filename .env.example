# Copy this file to `.env` and fill in your keys. Never commit .env.
# ---------------------------------------------------------------------------

# Claude (generation). Get one at https://console.anthropic.com/
# NOTE: Claude Max covers claude.ai chat, NOT programmatic API usage. This key
# is billed separately, per-token. For this project the cost is pennies.
ANTHROPIC_API_KEY=sk-ant-...

# Voyage AI (default embedding provider). https://www.voyageai.com/
# Anthropic's recommended partner for embeddings. Cost: ~$0.06 / 1M tokens.
VOYAGE_API_KEY=pa-...

# OpenAI (optional — only needed if you set EMBEDDING_PROVIDER=openai below)
# OPENAI_API_KEY=sk-...

# ---------------------------------------------------------------------------
# Provider + model selection. Change these to swap models without editing code.
# ---------------------------------------------------------------------------

# Which embedding backend to use. Options: voyage | openai
EMBEDDING_PROVIDER=voyage

# Model name for the chosen provider.
#   voyage: voyage-3.5, voyage-3.5-lite, voyage-3-large
#   openai: text-embedding-3-small, text-embedding-3-large
EMBEDDING_MODEL=voyage-3.5

# Claude model used for answer generation.
#   claude-haiku-4-5-20251001  — fastest, cheapest, good enough for this task
#   claude-sonnet-5            — better reasoning, slightly slower
CLAUDE_MODEL=claude-sonnet-5

# Where the local vector index lives on disk (relative to repo root).
# The directory holds vectors.npy + chunks.jsonl + manifest.json.
INDEX_PATH=./data/index
